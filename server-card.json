{
  "name": "a2aidentitytoll",
  "title": "A2A Identity Toll",
  "description": "A paid remote MCP gate that evaluates caller identity, scope, task intent, data class, and policy before agent-to-agent work proceeds.",
  "version": "1.0.0",
  "websiteUrl": "https://a2aidentitytoll.clauxel.com/",
  "documentationUrl": "https://a2aidentitytoll.clauxel.com/mcp/",
  "endpointUrl": "https://a2aidentitytoll.clauxel.com/mcp",
  "transport": "streamable-http",
  "authentication": {
    "type": "bearer",
    "required": true,
    "header": "Authorization",
    "format": "Bearer <paid-token>"
  },
  "paidAccess": {
    "required": true,
    "checkoutUrl": "https://a2aidentitytoll.clauxel.com/api/agent-checkout",
    "tokenStatusUrl": "https://a2aidentitytoll.clauxel.com/api/mcp-token/status",
    "tokenClaimUrl": "https://a2aidentitytoll.clauxel.com/api/mcp-token/claim",
    "defaultPlan": "team",
    "pricing": [
      {
        "id": "starter",
        "name": "Starter",
        "monthlyUsd": 49
      },
      {
        "id": "team",
        "name": "Team",
        "monthlyUsd": 149
      },
      {
        "id": "scale",
        "name": "Scale",
        "monthlyUsd": 399
      }
    ]
  },
